    // ==============================
    // XU LY CAU HOI
    // ==============================
    async function askGemini(question) {

        const loadingMessage = addLoadingMessage();

        sendButton.disabled = true;
        userInput.disabled = true;

        try {

            const response = await fetch(
                `${API_URL}/Invoice/api/ai/chat`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        message: question
                    })
                }
            );

            let result;

            try {
                result = await response.json();
            }
            catch {
                throw new Error(
                    "Server trả về dữ liệu không hợp lệ."
                );
            }

            console.log(
                "COFFEECRM AI:",
                result
            );

            if (!response.ok) {

                throw new Error(
                    result.message ||
                    "Không thể kết nối tới AI."
                );
            }

            if (!result.success || !result.answer) {

                throw new Error(
                    "AI không trả về câu trả lời."
                );
            }

            loadingMessage.remove();

            // Chuyển xuống dòng của Gemini thành HTML
            let formattedAnswer = result.answer
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
                .replace(/\n/g, "<br>");


            const answerHtml = `

            <div>

                <div style="
                    display:flex;
                    align-items:center;
                    gap:8px;
                    margin-bottom:10px;
                ">

                    <strong>
                        🤖 CoffeeCRM AI
                    </strong>

                    ${result.model
                    ? `
                                <span style="
                                    font-size:11px;
                                    padding:3px 8px;
                                    border-radius:20px;
                                    background:#eef4ff;
                                    color:#3975e9;
                                ">
                                    ${result.model}
                                </span>
                            `
                    : ""
                }

                </div>

                <div>
                    ${formattedAnswer}
                </div>

            </div>
        `;


            addMessage(
                answerHtml,
                "ai-message"
            );

        }
        catch (error) {

            console.error(
                "COFFEECRM AI ERROR:",
                error
            );

            if (loadingMessage) {
                loadingMessage.remove();
            }


            addMessage(
                `
                <strong>
                    ⚠️ Trợ lý AI tạm thời không phản hồi.
                </strong>

                <br><br>

                ${error.message}

                <br><br>

                Bạn vẫn có thể sử dụng
                4 chức năng phân tích nhanh phía trên.
            `,
                "ai-message"
            );

        }
        finally {

            sendButton.disabled = false;
            userInput.disabled = false;

            userInput.focus();
        }
    }

    async function handleQuestion(question) {

        if (!question || !question.trim()) {
            return;
        }

        const cleanQuestion = question.trim();
        const normalizedQuestion = cleanQuestion.toLowerCase();

        // Hiển thị câu hỏi của người dùng
        addMessage(cleanQuestion, "user-message");

        userInput.value = "";

        // ==========================================
        // 4 LENH NHANH - DUNG API NOI BO
        // ==========================================

        if (
            normalizedQuestion === "doanh thu hôm nay"
        ) {
            await getTodayRevenue();
            return;
        }

        if (
            normalizedQuestion === "món bán chạy"
        ) {
            await getTopSellingDishes();
            return;
        }

        if (
            normalizedQuestion === "kiểm tra tồn kho"
        ) {
            await getInventorySummary();
            return;
        }

        if (
            normalizedQuestion === "phân tích kinh doanh"
        ) {
            await getBusinessAnalysis();
            return;
        }

        // ==========================================
        // CHAT TU DO -> GEMINI
        // ==========================================

        await askGemini(cleanQuestion);
    }


    // ==============================
    // GUI BUTTON
    // ==============================

    sendButton.addEventListener(
        "click",
        async function () {

            const question =
                userInput.value;

            userInput.value = "";

            await handleQuestion(
                question
            );
        }
    );


    // ==============================
    // ENTER
    // ==============================

    userInput.addEventListener(
        "keydown",
        async function (event) {

            if (event.key === "Enter") {

                event.preventDefault();

                const question =
                    userInput.value;

                userInput.value = "";

                await handleQuestion(
                    question
                );
            }
        }
    );


    // ==============================
    // GOI Y
    // ==============================

    document
        .querySelectorAll(".suggestion-btn")
        .forEach(button => {

            button.addEventListener(
                "click",
                function () {

                    const question =
                        this.innerText.trim();

                    handleQuestion(question);
                }
            );
       
        });</script>